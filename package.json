{
  "name": "eslint-plugin-import-structure",
  "version": "0.12.0",
  "description": "ESLint and Oxlint rules that keep a module graph layered and free of cycles, with package.json \"#\" imports as the layer order.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "import",
    "import-structure",
    "imports",
    "oxlint"
  ],
  "homepage": "https://github.com/cunarist/eslint-plugin-import-structure#readme",
  "bugs": {
    "url": "https://github.com/cunarist/eslint-plugin-import-structure/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cunarist/eslint-plugin-import-structure.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#plugin": "./src/plugin/index.ts",
    "#rules": "./src/rules/index.ts",
    "#testing": "./src/testing/index.ts",
    "#helpers": "./src/helpers/index.ts"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "docs": "eslint-doc-generator"
  },
  "dependencies": {
    "@eslint/core": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/types": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-doc-generator": "^3.7.1",
    "eslint-plugin-explicit-types": "^0.7.0",
    "vite-plus": "^1.1.0"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "eslint-doc-generator": {
    "configEmoji": [
      [
        "modules",
        "🧭"
      ]
    ],
    "ignoreConfig": [
      "all"
    ],
    "ruleListColumns": [
      "name",
      "description",
      "configsError",
      "fixable",
      "hasSuggestions"
    ],
    "ruleDocSectionInclude": [
      "Rule Details",
      "When Not To Use It"
    ],
    "urlConfigs": "https://github.com/cunarist/eslint-plugin-import-structure#configs-and-rules"
  }
}
